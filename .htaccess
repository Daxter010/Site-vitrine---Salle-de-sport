# Protection par mot de passe
#AuthType Basic
#AuthName "Accès réservé"
#AuthUserFile "d:/wamp/www/Magic_Form_Romilly/.htpasswd"
#Require valid-user

# Bloquer l'accès direct aux fichiers de configuration
RewriteRule ^\config.php$ - [F]
# Bloquer l'accès direct au fichier .htaccess
RewriteRule ^\.htaccess$ - [F]

# Activer le module de réécriture
RewriteEngine On
# Définir la base de la réécriture
RewriteBase /
# Vérifier si le fichier demandé n'existe pas
RewriteCond %{REQUEST_FILENAME} !-f
# Vérifier si le répertoire demandé n'existe pas
RewriteCond %{REQUEST_FILENAME} !-d
# Réécrire l'URL pour diriger vers index.php avec le paramètre 'url'
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]